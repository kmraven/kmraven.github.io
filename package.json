{
  "name": "kmraven-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25", "npm": ">=10" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check && tsc --project tsconfig.scripts.json",
    "test": "node --test tests/*.test.ts",
    "test:site": "node scripts/check-site.ts",
    "verify": "npm run check && npm test && npm run build && npm run test:site",
    "import:researchmap": "node scripts/import-researchmap.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
