---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { data } from '../../data';
import type { Locale } from '../../data/schema';
import { copy, fullName, pagePath, hasResearchContent, pageDescription } from '../../lib/i18n';
import Localized from '../Localized.astro';
import Affiliations from '../Affiliations.astro';
import PublicationsSection from '../PublicationsSection.astro';
import ProfileLinks from '../ProfileLinks.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = copy[lang];
const name = fullName(data.profile, lang);
const secondaryName = fullName(data.profile, lang === 'ja' ? 'en' : 'ja');
const profile = await getEntry('profile', 'profile');
const photo = profile?.data.photo;
const about = await getEntry('about', lang);
const renderedAbout = about && hasResearchContent(about.data.published, about.body) ? await render(about) : undefined;
const AboutContent = renderedAbout?.Content;
const research = await getEntry('research', lang);
const showResearch = hasResearchContent(research?.data.published, research?.body);
const rendered = showResearch && research ? await render(research) : undefined;
const ResearchContent = rendered?.Content;
---
<SiteLayout lang={lang} page="home" title={`${name} | ${t.profile}`} description={pageDescription('home', lang, name)}>
  <section class:list={['profile', { 'has-photo': photo }]} aria-labelledby="profile-name">
    {photo && <Image src={photo} alt={lang === 'ja' ? `${name}のプロフィール写真` : `Portrait of ${name}`} class="profile-photo" width={152} widths={[96, 192, 304]} sizes="(max-width: 600px) 88px, 152px" format="webp" loading="eager" />}
    <div class="profile-names">
      <h1 id="profile-name">{name}</h1>
      <p class="secondary-name" lang={lang === 'ja' ? 'en' : 'ja'}>{secondaryName}</p>
    </div>
    <div class="profile-affiliations">
      <Affiliations lang={lang} />
    </div>
    {data.researchAreas.length > 0 && <div class="profile-research">
      <h2 id="areas-title">{t.researchAreas}</h2>
      <ul class="area-list" aria-labelledby="areas-title">{data.researchAreas.map((area) => <li><Localized value={area.field} lang={lang} /></li>)}</ul>
    </div>}
    <nav aria-label={t.moreProfile}><ProfileLinks cvHref={pagePath('cv', lang)} /></nav>
    {AboutContent && <div class="profile-bio prose"><AboutContent /></div>}
  </section>
  {ResearchContent && research && <section class="content-section research-section" aria-labelledby="research-title"><div class="section-heading"><h2 id="research-title">{research.data.title}</h2></div><div class="prose"><ResearchContent /></div></section>}
  {(data.publications.length > 0 || data.presentations.length > 0) && <PublicationsSection lang={lang} />}
</SiteLayout>
