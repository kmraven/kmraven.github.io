---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { data } from '../../data';
import type { Locale } from '../../data/schema';
import { copy, fullName, pageDescription } from '../../lib/i18n';
import PublicationEntry from '../PublicationEntry.astro';
import PresentationEntry from '../PresentationEntry.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = copy[lang];
const groups = [
  { id: 'papers', title: t.papers, entries: data.publications.filter((item) => item.kind === 'paper') },
  { id: 'preprints', title: t.preprints, entries: data.publications.filter((item) => item.kind === 'preprint') },
].filter((group) => group.entries.length);
---
<SiteLayout lang={lang} page="publications" title={`${t.publicationsTitle} | ${fullName(data.profile, lang)}`} description={pageDescription('publications', lang, fullName(data.profile, lang))}>
  <div class="page-heading"><p class="eyebrow" lang="en">Research outputs</p><h1>{t.publicationsTitle}</h1><p class="page-intro">{t.publicationsSubtitle}</p></div>
  <nav class="section-navigation" aria-label={lang === 'ja' ? '業績の種類' : 'Publication categories'}><ul>{groups.map((group) => <li><a href={`#${group.id}`}>{group.title}<span>{group.entries.length}</span></a></li>)}{data.presentations.length > 0 && <li><a href="#presentations">{t.presentations}<span>{data.presentations.length}</span></a></li>}</ul></nav>
  {groups.map((group) => <section class="content-section" aria-labelledby={group.id}><div class="section-heading"><h2 id={group.id}>{group.title}</h2><span class="section-count" aria-hidden="true">{String(group.entries.length).padStart(2, '0')}</span></div><ol class="output-list">{group.entries.map((item) => <PublicationEntry item={item} lang={lang} showAbstract />)}</ol></section>)}
  {data.presentations.length > 0 && <section class="content-section" aria-labelledby="presentations"><div class="section-heading"><h2 id="presentations">{t.presentations}</h2><span class="section-count" aria-hidden="true">{String(data.presentations.length).padStart(2, '0')}</span></div><ol class="output-list">{data.presentations.map((item) => <PresentationEntry item={item} lang={lang} />)}</ol></section>}
</SiteLayout>
