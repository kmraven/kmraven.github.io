  code: ['m8 6-6 6 6 6M16 6l6 6-6 6M14 4l-4 16'],
  external: ['M14 3h7v7M21 3l-9 9', 'M10 5H4v15h15v-6'],
  print: ['M6 9V3h12v6M6 18H3V9h18v9h-3M6 14h12v7H6Z'],
