---
import icons from '../data/brand-icons.json';
interface Props { name: keyof typeof icons; size?: number }
const { name, size = 20 } = Astro.props;
const icon = icons[name];
---
<svg class="brand-icon" width={size} height={size} viewBox={icon.viewBox} fill="currentColor" aria-hidden="true" focusable="false">
  <desc>Font Awesome Free 7.3.1 by Fonticons, Inc. — CC BY 4.0. https://fontawesome.com/license/free</desc>
  {icon.paths.map((d) => <path d={d} />)}
</svg>
