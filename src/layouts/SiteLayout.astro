---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import ActionIcon from '../components/ActionIcon.astro';
import { data } from '../data';
import type { Locale } from '../data/schema';
import { copy, fullName, pagePath, type PageKey } from '../lib/i18n';
interface Props { lang: Locale; page: PageKey; title: string; description: string }
const { lang, page, title, description } = Astro.props;
const t = copy[lang];
const otherLang = lang === 'ja' ? 'en' : 'ja';
const canonical = new URL(Astro.url.pathname, Astro.site);
const name = fullName(data.profile, 'en');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      (() => {
        let theme;
        try { theme = localStorage.getItem('portal-theme'); } catch { /* Fall back to the system preference. */ }
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
        const dark = theme === 'dark' || (theme !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.querySelector('meta[name="theme-color"]').setAttribute('content', dark ? '#171b20' : '#ffffff');
      })();
    </script>
    <meta name="google-site-verification" content="XKzroCfUg23AeUG42OXlQtdklgNaysMT5zr0aRGv_8U" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ja" href={new URL(pagePath(page, 'ja'), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(pagePath(page, 'en'), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(pagePath(page, 'ja'), Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={name} />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ja' ? 'en_US' : 'ja_JP'} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class:list={[`page-${page}`]}>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={pagePath('home', lang)} aria-label={`${name} — ${t.home}`}>{name}</a>
        <div class="header-navigation">
          <nav aria-label={t.navigation}>
            <ul class="nav-links">{(['home', 'cv', 'misc'] as const).map((key) => <li>
              <a href={pagePath(key, lang)} aria-current={page === key ? 'page' : undefined} aria-label={key === 'misc' ? t[key] : undefined} title={key === 'misc' ? t[key] : undefined} class:list={[{ 'nav-icon-link': key === 'misc' }]}>
                {key === 'misc' ? <ActionIcon name="grid" size={18} /> : t[key]}
              </a>
            </li>)}</ul>
          </nav>
          <div class="header-tools">
            <div class="language-switch" aria-label={lang === 'ja' ? '言語' : 'Language'}>
              <span aria-current="true" lang={lang}>{lang.toUpperCase()}</span><span class="language-divider" aria-hidden="true">/</span><a href={pagePath(page, otherLang)} lang={otherLang} hreflang={otherLang} aria-label={otherLang === 'en' ? 'English version' : '日本語版'}>{otherLang.toUpperCase()}</a>
            </div>
            <ThemeToggle lang={lang} />
          </div>
        </div>
      </div>
    </header>
    <main id="main" class="site-main" tabindex="-1"><slot /></main>
  </body>
</html>
